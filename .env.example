OMR_ENV=development
OMR_HOST=0.0.0.0
OMR_PORT=8000
OMR_INTERNAL_TOKEN=replace_with_64_plus_random_chars_internal_omr_token
OMR_MAX_UPLOAD_MB=16
OMR_MAX_PAYLOAD_KB=128
OMR_MAX_PDF_PAGES=6
OMR_PAGE_CONCURRENCY=1
OMR_REQUEST_TIMEOUT_SECONDS=120
OMR_PROCESS_ISOLATION=true
OMR_MIN_CONFIDENCE_FOR_AUTO_APPROVAL=0.88
